{
  "entities": {
    "Company": {
      "title": "Company Overview",
      "description": "Corporation details and incorporation settings",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 200 },
        "suffix": { "type": "string", "maxLength": 50 },
        "targetClosing": { "type": "string", "maxLength": 100 },
        "state": { "type": "string", "maxLength": 100 },
        "incorporationDate": { "type": "string", "maxLength": 50 },
        "delawareFileNumber": { "type": "string", "maxLength": 50 },
        "ein": { "type": "string", "maxLength": 50 },
        "totalAuthorizedShares": { "type": "number" },
        "reservedEquityPool": { "type": "number" },
        "parValue": { "type": "number" },
        "registeredAgent": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "maxLength": 200 },
            "address": { "type": "string", "maxLength": 500 },
            "email": { "type": "string", "maxLength": 200 }
          },
          "required": ["name", "address", "email"]
        }
      },
      "required": ["name", "suffix", "state", "totalAuthorizedShares", "parValue"]
    },
    "Stockholder": {
      "title": "Stockholder",
      "description": "Cap table member and shareholder record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "email": { "type": "string", "maxLength": 200 },
        "shareClass": { "type": "string", "enum": ["Common", "Preferred", "Options"] },
        "shareCount": { "type": "number" },
        "pricePerShare": { "type": "number" },
        "vestingYears": { "type": "number" },
        "cliffMonths": { "type": "number" },
        "vestingStartDate": { "type": "string", "maxLength": 50 },
        "hasRestrictedStock": { "type": "boolean" },
        "election83bFiled": { "type": "boolean" },
        "election83bDeadline": { "type": "string", "maxLength": 50 },
        "avatarUrl": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "name", "email", "shareClass", "shareCount"]
    },
    "LegalDocument": {
      "title": "Legal Document",
      "description": "Corporate vault document and execution state",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 300 },
        "category": { "type": "string", "enum": ["Incorporation", "Board", "Stock", "IP & Protection", "Tax"] },
        "shareCountText": { "type": "string", "maxLength": 50 },
        "signatureStatus": { "type": "string", "maxLength": 50 },
        "isSigned": { "type": "boolean" },
        "signedDate": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 1000 },
        "content": { "type": "string", "maxLength": 50000 }
      },
      "required": ["id", "name", "category", "isSigned", "content"]
    },
    "Notification": {
      "title": "Notification Item",
      "description": "System alert or action reminder",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 1000 },
        "time": { "type": "string", "maxLength": 100 },
        "unread": { "type": "boolean" },
        "type": { "type": "string", "enum": ["urgent", "info", "success"] }
      },
      "required": ["id", "title", "message", "unread", "type"]
    }
  },
  "firestore": {
    "/companies/{companyId}": {
      "schema": { "$ref": "#/entities/Company" },
      "description": "Company profile records"
    },
    "/stockholders/{stockholderId}": {
      "schema": { "$ref": "#/entities/Stockholder" },
      "description": "Stockholders and cap table entries"
    },
    "/documents/{documentId}": {
      "schema": { "$ref": "#/entities/LegalDocument" },
      "description": "Legal vault documents"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "User notifications"
    }
  }
}
